/* ============================================================
   NEURODIVERGÊNCIA — ESTILO DA INTERFACE
   ============================================================ */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

:root {
    --fundo: #f5f7fb;
    --branco: #ffffff;
    --texto: #18202a;
    --texto-secundario: #667085;
    --borda: #e4e7ec;
    --principal: #263238;
    --principal-hover: #37474f;
    --selecionado: #eef2f5;
    --barra: #263238;
    --sombra: 0 10px 35px rgba(16, 24, 40, 0.08);
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: var(--fundo);
    color: var(--texto);
    min-height: 100vh;
}


/* ============================================================
   CABEÇALHO
   ============================================================ */

header {
    background: var(--branco);
    border-bottom: 1px solid var(--borda);
    padding: 24px 7%;
}

.logo {
    font-size: 30px;
    font-weight: 700;
    letter-spacing: -1px;
}

.logo span {
    font-weight: 400;
}

header p {
    margin-top: 7px;
    color: var(--texto-secundario);
    font-size: 15px;
}


/* ============================================================
   CONTEÚDO
   ============================================================ */

main {
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
    padding: 55px 20px;
}

.tela {
    display: none;
}

.tela.ativa {
    display: block;
}


/* ============================================================
   CARTÕES
   ============================================================ */

.card {
    background: var(--branco);
    border: 1px solid var(--borda);
    border-radius: 20px;
    padding: 38px;
    margin-bottom: 25px;
    box-shadow: var(--sombra);
}

.principal {
    text-align: center;
    padding: 75px 55px;
}

.principal h1 {
    max-width: 720px;
    margin: 0 auto 20px;
    font-size: 44px;
    line-height: 1.12;
    letter-spacing: -1.5px;
}

.principal p {
    max-width: 680px;
    margin: 0 auto 35px;
    color: var(--texto-secundario);
    font-size: 17px;
    line-height: 1.7;
}

h2 {
    font-size: 28px;
    line-height: 1.25;
    margin-bottom: 10px;
}

.descricao {
    color: var(--texto-secundario);
    line-height: 1.6;
    margin-bottom: 28px;
}


/* ============================================================
   FORMULÁRIO
   ============================================================ */

label {
    display: block;
    margin: 20px 0 8px;
    font-size: 14px;
    font-weight: 600;
}

input,
textarea {
    width: 100%;
    padding: 14px 15px;
    border: 1px solid #d0d5dd;
    border-radius: 11px;
    background: #ffffff;
    color: var(--texto);
    font-family: inherit;
    font-size: 15px;
    outline: none;
    transition: border-color 0.2s, box-shadow 0.2s;
}

input:focus,
textarea:focus {
    border-color: #667085;
    box-shadow: 0 0 0 3px rgba(102, 112, 133, 0.10);
}

textarea {
    min-height: 105px;
    resize: vertical;
}

.linha {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
}


/* ============================================================
   BOTÕES
   ============================================================ */

button {
    width: 100%;
    border: none;
    border-radius: 11px;
    padding: 15px 20px;
    margin-top: 28px;
    background: var(--principal);
    color: #ffffff;
    font-family: inherit;
    font-size: 15px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s, transform 0.2s, box-shadow 0.2s;
}

button:hover {
    background: var(--principal-hover);
    transform: translateY(-1px);
    box-shadow: 0 5px 15px rgba(16, 24, 40, 0.12);
}

button:disabled {
    background: #c5cbd1;
    cursor: not-allowed;
    transform: none;
    box-shadow: none;
}


/* ============================================================
   AVALIAÇÃO
   ============================================================ */

.topo-avaliacao {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 15px;
    margin-bottom: 14px;
    color: var(--texto-secundario);
    font-size: 14px;
}

#estrategia {
    font-weight: 600;
    color: var(--texto);
}

.barra {
    width: 100%;
    height: 9px;
    margin-bottom: 35px;
    background: #e9edf2;
    border-radius: 50px;
    overflow: hidden;
}

#progresso {
    width: 4%;
    height: 100%;
    background: var(--barra);
    border-radius: 50px;
    transition: width 0.3s ease;
}

#pergunta {
    font-size: 25px;
    line-height: 1.45;
    margin-bottom: 25px;
}


/* ============================================================
   ALTERNATIVAS
   ============================================================ */

.alternativa {
    display: block;
    width: 100%;
    padding: 17px 18px;
    margin: 10px 0;
    border: 1px solid #d8dde3;
    border-radius: 12px;
    background: #ffffff;
    color: var(--texto);
    font-family: inherit;
    font-size: 15px;
    font-weight: 500;
    text-align: left;
    cursor: pointer;
    transition: all 0.2s ease;
}

.alternativa:hover {
    background: #f8fafc;
    border-color: #aeb6bf;
    transform: translateY(-1px);
}

.alternativa.selecionada {
    background: var(--selecionado);
    border-color: #263238;
    box-shadow: 0 0 0 2px rgba(38, 50, 56, 0.08);
}


/* ============================================================
   DIFICULDADE
   ============================================================ */

.dificuldade {
    margin-top: 32px;
    padding-top: 25px;
    border-top: 1px solid var(--borda);
}

.dificuldade label {
    margin-top: 0;
}

input[type="range"] {
    padding: 0;
    margin-top: 10px;
    height: 6px;
    accent-color: var(--principal);
    cursor: pointer;
}

.escala {
    display: flex;
    justify-content: space-between;
    margin-top: 7px;
    color: var(--texto-secundario);
    font-size: 12px;
}


/* ============================================================
   RESULTADOS
   ============================================================ */

.resultados {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 28px;
}

.resultado-item {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 70px;
    padding: 17px 18px;
    border: 1px solid var(--borda);
    border-radius: 13px;
    background: #fafbfc;
}

.resultado-item span {
    color: var(--texto-secundario);
    font-size: 14px;
}

.resultado-item strong {
    font-size: 20px;
    color: var(--texto);
}


/* ============================================================
   MENSAGEM DO RESULTADO
   ============================================================ */

#mensagemResultado {
    color: var(--texto-secundario);
    line-height: 1.7;
    margin-top: 15px;
}

#mensagemResultado strong {
    color: var(--texto);
}


/* ============================================================
   ATIVIDADES
   ============================================================ */

#atividades {
    margin-top: 25px;
}

#listaAtividades {
    margin-top: 18px;
    color: var(--texto-secundario);
    line-height: 1.7;
}


/* ============================================================
   RODAPÉ
   ============================================================ */

footer {
    padding: 30px 20px;
    border-top: 1px solid var(--borda);
    background: #ffffff;
    color: #7a838e;
    text-align: center;
    font-size: 13px;
}


/* ============================================================
   RESPONSIVIDADE
   ============================================================ */

@media (max-width: 700px) {

    header {
        padding: 22px 20px;
    }

    .logo {
        font-size: 26px;
    }

    main {
        padding: 30px 15px;
    }

    .card {
        padding: 27px 20px;
        border-radius: 16px;
    }

    .principal {
        padding: 50px 22px;
    }

    .principal h1 {
        font-size: 34px;
    }

    .principal p {
        font-size: 16px;
    }

    .linha {
        grid-template-columns: 1fr;
        gap: 0;
    }

    .resultados {
        grid-template-columns: 1fr;
    }

    .topo-avaliacao {
        flex-direction: column;
        align-items: flex-start;
        gap: 7px;
    }

    #pergunta {
        font-size: 22px;
    }
}


@media (max-width: 430px) {

    .principal h1 {
        font-size: 29px;
    }

    h2 {
        font-size: 24px;
    }

    .card {
        padding: 23px 17px;
    }

    .resultado-item {
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
    }
}
