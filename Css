* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

:root {
    --fundo: #f4f6fb;
    --branco: #ffffff;
    --texto: #202536;
    --texto-secundario: #667085;
    --principal: #5964e8;
    --principal-escura: #4852d4;
    --borda: #e3e6ef;
    --sucesso: #23865b;
    --erro: #c63f4c;
    --sombra: 0 12px 35px rgba(31, 41, 55, 0.08);
}

body {
    font-family:
        Inter,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;

    background: var(--fundo);
    color: var(--texto);
    min-height: 100vh;
}


/* =========================================================
   CABEÇALHO
========================================================= */

.cabecalho {
    text-align: center;
    padding: 35px 20px 25px;
}

.logo {
    font-size: 32px;
    font-weight: 800;
    letter-spacing: -1px;
}

.logo span {
    color: var(--principal);
}

.cabecalho p {
    margin-top: 8px;
    color: var(--texto-secundario);
}


/* =========================================================
   ESTRUTURA
========================================================= */

main {
    width: min(1050px, calc(100% - 30px));
    margin: 0 auto;
    padding-bottom: 50px;
}

.tela {
    display: none;
}

.tela.ativa {
    display: block;
}

.card {
    background: var(--branco);
    border: 1px solid var(--borda);
    border-radius: 24px;
    box-shadow: var(--sombra);
    padding: 35px;
}

.principal {
    max-width: 800px;
    margin: 60px auto;
    text-align: center;
    padding: 60px 40px;
}

.principal h1 {
    font-size: 38px;
    line-height: 1.15;
    margin: 20px 0;
}

.principal p {
    max-width: 650px;
    margin: 0 auto 30px;
    color: var(--texto-secundario);
    line-height: 1.7;
}


/* =========================================================
   ÍCONES
========================================================= */

.icone {
    width: 70px;
    height: 70px;
    border-radius: 20px;
    background: #eef0ff;
    color: var(--principal);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
    font-weight: 800;
    font-size: 20px;
}

.icone.pequeno {
    width: 55px;
    height: 55px;
    font-size: 16px;
}


/* =========================================================
   CABEÇALHO DOS CARDS
========================================================= */

.cabecalho-card {
    display: flex;
    align-items: flex-start;
    gap: 18px;
    margin-bottom: 35px;
}

.numero-etapa {
    min-width: 48px;
    height: 48px;
    border-radius: 14px;
    background: #eef0ff;
    color: var(--principal);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
}

.cabecalho-card h2 {
    font-size: 27px;
}

.cabecalho-card p {
    color: var(--texto-secundario);
    margin-top: 5px;
}


/* =========================================================
   FORMULÁRIO
========================================================= */

.formulario {
    display: flex;
    flex-direction: column;
    gap: 20px;
}

.campo {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.campo label {
    font-weight: 650;
}

input,
textarea {
    width: 100%;
    border: 1px solid var(--borda);
    border-radius: 12px;
    padding: 14px 15px;
    font-size: 16px;
    background: white;
    color: var(--texto);
    outline: none;
    transition: 0.2s;
}

input:focus,
textarea:focus {
    border-color: var(--principal);
    box-shadow: 0 0 0 3px rgba(89, 100, 232, 0.1);
}

textarea {
    resize: vertical;
}

.duas-colunas {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
}


/* =========================================================
   BOTÕES
========================================================= */

.btn {
    border: 0;
    border-radius: 13px;
    padding: 15px 22px;
    font-size: 16px;
    font-weight: 700;
    cursor: pointer;
    transition: 0.2s;
}

.btn:disabled {
    opacity: 0.5;
    cursor: not-allowed;
}

.principal-btn {
    background: var(--principal);
    color: white;
}

.principal-btn:hover {
    background: var(--principal-escura);
    transform: translateY(-1px);
}

.secundario-btn {
    background: #eef0f5;
    color: var(--texto);
}

.secundario-btn:hover {
    background: #e2e5ec;
}


/* =========================================================
   MENSAGENS
========================================================= */

.mensagem {
    border-radius: 12px;
    padding: 14px;
    line-height: 1.5;
}

.erro {
    background: #fff0f1;
    color: var(--erro);
    border: 1px solid #ffd0d4;
}


/* =========================================================
   PREPARAÇÃO
========================================================= */

.centralizado {
    text-align: center;
    padding: 70px 30px;
}

.centralizado h2 {
    margin: 22px 0 10px;
}

.centralizado p {
    color: var(--texto-secundario);
    line-height: 1.6;
}

.spinner {
    width: 45px;
    height: 45px;
    border: 4px solid #e3e6f5;
    border-top-color: var(--principal);
    border-radius: 50%;
    animation: girar 0.8s linear infinite;
    margin: 25px auto;
}

@keyframes girar {
    to {
        transform: rotate(360deg);
    }
}

.etapas-preparacao {
    max-width: 500px;
    margin: 30px auto 0;
    display: grid;
    gap: 10px;
    text-align: left;
}

.etapas-preparacao div {
    background: #f7f8fc;
    padding: 14px;
    border-radius: 10px;
}


/* =========================================================
   AVALIAÇÃO
========================================================= */

.avaliacao-container {
    max-width: 900px;
    margin: auto;
}

.barra-superior {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
    font-weight: 700;
}

.badge {
    display: inline-block;
    margin-left: 10px;
    padding: 7px 12px;
    border-radius: 20px;
    background: #eef0ff;
    color: var(--principal);
    font-size: 13px;
}

#materiaAtual {
    color: var(--texto-secundario);
}

.barra-progresso {
    height: 8px;
    background: #e5e7ef;
    border-radius: 20px;
    overflow: hidden;
    margin-bottom: 20px;
}

#progresso {
    width: 0%;
    height: 100%;
    background: var(--principal);
    transition: width 0.3s;
}

.questao-card {
    padding: 35px;
}

.numero-questao {
    color: var(--principal);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 1px;
}

#tituloQuestao {
    font-size: 30px;
    margin-top: 10px;
}

.objetivo {
    margin-top: 18px;
    padding: 15px;
    background: #f6f7fb;
    border-radius: 12px;
    color: var(--texto-secundario);
}

.enunciado {
    font-size: 20px;
    line-height: 1.7;
    margin: 28px 0;
}


/* =========================================================
   APOIO VISUAL
========================================================= */

.apoio-visual {
    margin: 20px 0;
    padding: 20px;
    background: #f7f8fc;
    border-radius: 15px;
}

.apoio-visual h3,
.passos h3 {
    margin-bottom: 14px;
}

.visual-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    gap: 10px;
}

.visual-item {
    padding: 14px;
    background: white;
    border: 1px solid var(--borda);
    border-radius: 10px;
    text-align: center;
}


/* =========================================================
   PASSOS
========================================================= */

.passos {
    margin: 20px 0;
}

.step {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    padding: 13px;
    background: #f7f8fc;
    border-radius: 10px;
    margin-bottom: 8px;
}

.step strong {
    min-width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--principal);
    color: white;
    display: flex;
    justify-content: center;
    align-items: center;
}


/* =========================================================
   ALTERNATIVAS
========================================================= */

.alternativas {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 13px;
}

.alternativa {
    padding: 18px;
    border: 2px solid var(--borda);
    border-radius: 14px;
    background: white;
    cursor: pointer;
    text-align: left;
    font-size: 16px;
    transition: 0.2s;
}

.alternativa:hover {
    border-color: var(--principal);
    background: #fafaff;
}

.alternativa.selecionada {
    border-color: var(--principal);
    background: #eef0ff;
}

.letra-alternativa {
    display: inline-flex;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    align-items: center;
    justify-content: center;
    background: #eef0ff;
    color: var(--principal);
    font-weight: 800;
    margin-right: 8px;
}


/* =========================================================
   DIFICULDADE
========================================================= */

.dificuldade-box {
    margin-top: 30px;
}

.dificuldade-box label {
    display: block;
    font-weight: 700;
    margin-bottom: 12px;
}

.dificuldades {
    display: flex;
    gap: 10px;
}

.dificuldade {
    border: 1px solid var(--borda);
    background: white;
    padding: 11px 18px;
    border-radius: 10px;
    cursor: pointer;
}

.dificuldade.selecionada {
    background: var(--principal);
    color: white;
    border-color: var(--principal);
}


/* =========================================================
   FEEDBACK
========================================================= */

.feedback {
    margin-top: 20px;
    padding: 15px;
    border-radius: 12px;
    background: #f5f6fa;
    line-height: 1.6;
}


/* =========================================================
   AÇÕES
========================================================= */

.acoes {
    display: flex;
    gap: 12px;
    margin-top: 30px;
}

.acoes .btn {
    flex: 1;
}


/* =========================================================
   RESULTADO
========================================================= */

.resultado-principal {
    padding: 28px;
    border-radius: 18px;
    background: #eef0ff;
    text-align: center;
    margin-bottom: 25px;
}

.resultado-principal h3 {
    color: var(--principal);
    margin-bottom: 10px;
}

.resultado-principal h2 {
    font-size: 28px;
    margin-bottom: 8px;
}

.resultados-estrategias {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
}

.resultado-item {
    border: 1px solid var(--borda);
    border-radius: 15px;
    padding: 20px;
}

.resultado-item .nome {
    font-weight: 700;
}

.resultado-item .valor {
    font-size: 28px;
    font-weight: 800;
    color: var(--principal);
    margin-top: 8px;
}

.resultado-item .detalhes {
    color: var(--texto-secundario);
    margin-top: 6px;
    font-size: 14px;
}

.resumo-geral {
    margin-top: 25px;
    padding: 20px;
    background: #f7f8fc;
    border-radius: 15px;
    line-height: 1.7;
}


/* =========================================================
   ATIVIDADES
========================================================= */

.atividade-adaptada {
    border: 1px solid var(--borda);
    border-radius: 18px;
    padding: 25px;
    margin-bottom: 18px;
}

.atividade-adaptada .estrategia {
    display: inline-block;
    background: #eef0ff;
    color: var(--principal);
    padding: 7px 12px;
    border-radius: 20px;
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 12px;
}

.atividade-adaptada h3 {
    margin-bottom: 10px;
}

.atividade-adaptada .objetivo {
    margin: 10px 0;
}

.atividade-adaptada .enunciado {
    font-size: 17px;
    margin: 15px 0;
}


/* =========================================================
   RODAPÉ
========================================================= */

footer {
    text-align: center;
    padding: 30px 20px;
    color: var(--texto-secundario);
    font-size: 14px;
}


/* =========================================================
   RESPONSIVO
========================================================= */

@media (max-width: 700px) {

    .principal {
        margin: 25px auto;
        padding: 40px 25px;
    }

    .principal h1 {
        font-size: 30px;
    }

    .card {
        padding: 22px;
    }

    .duas-colunas,
    .alternativas,
    .resultados-estrategias {
        grid-template-columns: 1fr;
    }

    .barra-superior {
        align-items: flex-start;
        gap: 10px;
        flex-direction: column;
    }

    .badge {
        margin-left: 0;
    }

    .dificuldades {
        flex-direction: column;
    }

    .acoes {
        flex-direction: column;
    }
}
