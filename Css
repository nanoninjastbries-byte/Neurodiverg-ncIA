/* ============================================================
   ELEMENTOS EXTRAS DA NEURODIVERGÊNCIA
============================================================ */

.mensagem-erro {
    margin-top: 15px;
    padding: 12px 14px;
    border-radius: 10px;
    background: #fef2f2;
    color: #b42318;
    border: 1px solid #fecdca;
}

.oculto {
    display: none !important;
}

.feedback {
    margin-top: 20px;
    padding: 15px;
    border-radius: 10px;
    background: #f4f6f8;
    color: #20242a;
    line-height: 1.6;
}

.feedback.correta {
    background: #eef8f1;
    color: #176b36;
}

.feedback.incorreta {
    background: #fff1f1;
    color: #9f2222;
}

.estrategia {
    display: inline-block;
    margin-top: 8px;
    padding: 6px 10px;
    border-radius: 8px;
    background: #eef0f2;
    color: #20242a;
    font-size: 13px;
}

.passos {
    margin: 20px 0;
    padding: 18px;
    border-radius: 11px;
    background: #f4f6f8;
}

.passos ol {
    padding-left: 22px;
    margin-top: 10px;
}

.visual {
    margin: 20px 0;
    padding: 18px;
    border-radius: 11px;
    background: #f4f6f8;
}

.loading {
    text-align: center;
    padding: 40px 20px;
    color: #68717d;
}

.loading::after {
    content: "";
    display: block;
    width: 28px;
    height: 28px;
    margin: 20px auto 0;
    border: 3px solid #dfe3e7;
    border-top-color: #20242a;
    border-radius: 50%;
    animation: carregando 0.8s linear infinite;
}

@keyframes carregando {
    to {
        transform: rotate(360deg);
    }
}

.atividade {
    background: white;
    border: 1px solid #e1e5e9;
    border-radius: 11px;
    padding: 20px;
    margin-bottom: 15px;
}

.atividade h3 {
    margin-bottom: 10px;
}

.atividade p {
    line-height: 1.7;
    color: #555e68;
}

@media (max-width: 650px) {

    .resultado-item {
        flex-direction: column;
        align-items: flex-start;
        gap: 8px;
    }

}
