/* ============================================================
   NEURODIVERGÊNCIA
   ESTILO PRINCIPAL
============================================================ */

:root {
    --fundo: #f5f7fb;
    --fundo-card: #ffffff;
    --texto: #172033;
    --texto-secundario: #667085;
    --borda: #e4e7ec;
    --principal: #3157d5;
    --principal-hover: #2748b7;
    --principal-claro: #eef2ff;
    --sucesso: #16865b;
    --erro: #c93636;
    --sombra: 0 18px 45px rgba(16, 24, 40, 0.08);
    --raio: 18px;
}

/* ============================================================
   RESET
============================================================ */

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

html {
    scroll-behavior: smooth;
}

body {
    min-height: 100vh;
    background: var(--fundo);
    color: var(--texto);
    font-family:
        Inter,
        system-ui,
        -apple-system,
        BlinkMacSystemFont,
        "Segoe UI",
        sans-serif;
    line-height: 1.6;
}

button,
input,
textarea {
    font: inherit;
}

button {
    cursor: pointer;
}

/* ============================================================
   TELAS
   ESTE É O PONTO MAIS IMPORTANTE
============================================================ */

.tela {
    display: none;
    min-height: calc(100vh - 90px);
}

.tela.ativa {
    display: block;
}

/* ============================================================
   TOPO
============================================================ */

.topo {
    height: 90px;
    display: flex;
    align-items: center;
    padding: 0 6%;
    background: #ffffff;
    border-bottom: 1px solid var(--borda);
}

.marca {
    display: flex;
    flex-direction: column;
}

.marca-nome {
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.5px;
}

.marca-nome span {
    color: var(--principal);
}

.marca-subtitulo {
    font-size: 12px;
    color: var(--texto-secundario);
}

/* ============================================================
   HERO
============================================================ */

.hero {
    width: min(900px, 90%);
    margin: auto;
    min-height: calc(100vh - 170px);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
}

.hero-badge,
.icone-ia {
    width: 58px;
    height: 58px;
    border-radius: 16px;
    background: var(--principal);
    color: white;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    margin-bottom: 25px;
}

.hero h1 {
    max-width: 800px;
    font-size: clamp(42px, 7vw, 76px);
    line-height: 1.02;
    letter-spacing: -3px;
    margin-bottom: 25px;
}

.hero h1 span {
    display: block;
    color: var(--principal);
}

.hero p {
    max-width: 720px;
    color: var(--texto-secundario);
    font-size: 18px;
    margin-bottom: 35px;
}

/* ============================================================
   PÁGINAS
============================================================ */

.pagina {
    width: min(1050px, 90%);
    margin: 0 auto;
    padding: 70px 0;
}

.pagina-centralizada {
    min-height: calc(100vh - 90px);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
}

.cabecalho-pagina {
    margin-bottom: 45px;
}

.cabecalho-pagina h2,
.pagina-centralizada h2 {
    font-size: clamp(32px, 5vw, 48px);
    line-height: 1.1;
    letter-spacing: -1.5px;
    margin: 10px 0 15px;
}

.cabecalho-pagina p,
.pagina-centralizada > p {
    color: var(--texto-secundario);
    max-width: 700px;
}

.numero-tela {
    color: var(--principal);
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 2px;
}

/* ============================================================
   BOTÕES
============================================================ */

.btn {
    border: 0;
    border-radius: 12px;
    padding: 14px 22px;
    font-weight: 700;
    transition: 0.2s ease;
}

.btn:disabled {
    cursor: not-allowed;
    opacity: 0.45;
}

.btn-principal {
    background: var(--principal);
    color: white;
}

.btn-principal:hover:not(:disabled) {
    background: var(--principal-hover);
    transform: translateY(-1px);
}

.btn-secundario {
    background: white;
    color: var(--texto);
    border: 1px solid var(--borda);
}

.btn-secundario:hover:not(:disabled) {
    background: #f8f9fc;
}

/* ============================================================
   FORMULÁRIO
============================================================ */

.grid-form {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 22px;
}

.campo {
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.campo-grande {
    grid-column: span 2;
}

.campo-total {
    grid-column: 1 / -1;
}

.campo label {
    font-size: 14px;
    font-weight: 700;
}

.campo label span {
    color: var(--erro);
}

.campo input,
.campo textarea {
    width: 100%;
    border: 1px solid var(--borda);
    border-radius: 12px;
    padding: 14px 15px;
    background: white;
    color: var(--texto);
    outline: none;
    transition: 0.2s;
}

.campo input:focus,
.campo textarea:focus {
    border-color: var(--principal);
    box-shadow: 0 0 0 3px rgba(49, 87, 213, 0.1);
}

.campo textarea {
    resize: vertical;
}

#formAvaliacao .btn {
    margin-top: 28px;
}

/* ============================================================
   MENSAGENS
============================================================ */

.mensagem {
    padding: 13px 15px;
    border-radius: 10px;
    margin-top: 20px;
}

.mensagem.erro {
    background: #fff1f1;
    color: var(--erro);
    border: 1px solid #ffd0d0;
}

/* ============================================================
   PREPARAÇÃO
============================================================ */

.etapas-preparacao {
    width: min(600px, 100%);
    margin: 40px 0 25px;
    display: flex;
    flex-direction: column;
    gap: 12px;
}

.etapa-preparacao {
    display: flex;
    align-items: center;
    gap: 15px;
    text-align: left;
    padding: 17px;
    border: 1px solid var(--borda);
    border-radius: 14px;
    background: white;
    opacity: 0.45;
}

.etapa-preparacao.ativa {
    opacity: 1;
    border-color: var(--principal);
    background: var(--principal-claro);
}

.etapa-preparacao.concluida {
    opacity: 1;
}

.etapa-preparacao > span {
    font-weight: 800;
    color: var(--principal);
}

.etapa-preparacao div {
    display: flex;
    flex-direction: column;
}

.etapa-preparacao small {
    color: var(--texto-secundario);
}

.status-preparacao {
    color: var(--texto-secundario);
    margin-bottom: 25px;
}

/* ============================================================
   AVALIAÇÃO
============================================================ */

.avaliacao-container {
    width: min(900px, 92%);
    margin: 0 auto;
    padding: 45px 0 70px;
}

.avaliacao-topo {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 12px;
}

#contador {
    font-weight: 800;
}

.badge-estrategia {
    display: inline-block;
    margin-left: 10px;
    padding: 5px 10px;
    border-radius: 999px;
    background: var(--principal-claro);
    color: var(--principal);
    font-size: 12px;
    font-weight: 700;
}

.barra-progresso {
    width: 100%;
    height: 8px;
    border-radius: 20px;
    overflow: hidden;
    background: #e6e9f0;
    margin-bottom: 30px;
}

.barra-progresso-preenchida {
    width: 0%;
    height: 100%;
    background: var(--principal);
    transition: width 0.3s ease;
}

.questao-card {
    background: white;
    border: 1px solid var(--borda);
    border-radius: var(--raio);
    box-shadow: var(--sombra);
    padding: clamp(25px, 5vw, 50px);
}

.questao-meta {
    color: var(--principal);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 2px;
    margin-bottom: 15px;
}

.titulo-questao {
    font-size: clamp(24px, 4vw, 36px);
    line-height: 1.2;
    margin-bottom: 10px;
}

.objetivo-questao {
    color: var(--texto-secundario);
    font-size: 14px;
    margin-bottom: 25px;
}

.enunciado {
    font-size: 18px;
    line-height: 1.7;
    margin-bottom: 30px;
    white-space: pre-wrap;
}

/* ============================================================
   PASSOS E VISUAL
============================================================ */

.bloco-extra {
    margin: 20px 0;
    padding: 18px;
    border-radius: 12px;
    background: #f8f9fc;
    border: 1px solid var(--borda);
}

.bloco-extra h3 {
    font-size: 15px;
    margin-bottom: 10px;
}

.bloco-extra ol {
    padding-left: 22px;
}

#listaVisual {
    display: flex;
    flex-direction: column;
    gap: 7px;
}

/* ============================================================
   ALTERNATIVAS
============================================================ */

.alternativas {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
}

.alternativa {
    width: 100%;
    min-height: 65px;
    text-align: left;
    border: 1px solid var(--borda);
    background: white;
    color: var(--texto);
    border-radius: 12px;
    padding: 14px 16px;
    transition: 0.2s ease;
}

.alternativa:hover {
    border-color: var(--principal);
    background: var(--principal-claro);
}

.alternativa.selecionada {
    border-color: var(--principal);
    background: var(--principal-claro);
    box-shadow: 0 0 0 2px rgba(49, 87, 213, 0.1);
}

/* ============================================================
   DIFICULDADE
============================================================ */

.dificuldade-box {
    margin-top: 30px;
    padding-top: 25px;
    border-top: 1px solid var(--borda);
}

.dificuldade-box > label {
    display: block;
    font-weight: 700;
    margin-bottom: 12px;
}

.dificuldade-opcoes {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
}

.dificuldade-opcoes label {
    cursor: pointer;
}

.dificuldade-opcoes input {
    position: absolute;
    opacity: 0;
}

.dificuldade-opcoes span {
    display: inline-block;
    padding: 9px 14px;
    border: 1px solid var(--borda);
    border-radius: 999px;
    background: white;
}

.dificuldade-opcoes input:checked + span {
    border-color: var(--principal);
    background: var(--principal-claro);
    color: var(--principal);
}

/* ============================================================
   FEEDBACK
============================================================ */

.feedback {
    margin-top: 20px;
    padding: 15px;
    border-radius: 12px;
    font-size: 14px;
}

.feedback.correta {
    background: #edf9f3;
    color: var(--sucesso);
}

.feedback.incorreta {
    background: #fff1f1;
    color: var(--erro);
}

/* ============================================================
   AÇÕES
============================================================ */

.acoes-questao,
.acoes-resultado {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin-top: 30px;
}

/* ============================================================
   LOADING
============================================================ */

.loading-circle {
    width: 48px;
    height: 48px;
    margin: 30px auto;
    border-radius: 50%;
    border: 4px solid #e1e5ef;
    border-top-color: var(--principal);
    animation: girar 0.9s linear infinite;
}

@keyframes girar {
    to {
        transform: rotate(360deg);
    }
}

/* ============================================================
   RELATÓRIO
============================================================ */

.relatorio {
    display: grid;
    gap: 18px;
}

.relatorio-resumo {
    background: white;
    border: 1px solid var(--borda);
    border-radius: var(--raio);
    padding: 25px;
}

.relatorio-resumo h3 {
    margin-bottom: 8px;
}

.relatorio-resumo p {
    color: var(--texto-secundario);
}

.cartoes-estrategias {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 15px;
}

.cartao-estrategia {
    background: white;
    border: 1px solid var(--borda);
    border-radius: 15px;
    padding: 22px;
}

.cartao-estrategia h3 {
    font-size: 16px;
    margin-bottom: 15px;
}

.percentual {
    font-size: 36px;
    font-weight: 800;
    color: var(--principal);
}

.dados-estrategia {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    color: var(--texto-secundario);
    font-size: 13px;
}

/* ============================================================
   ATIVIDADES ADAPTADAS
============================================================ */

.atividades-adaptadas {
    display: grid;
    gap: 18px;
    margin-bottom: 30px;
}

.atividade-adaptada {
    background: white;
    border: 1px solid var(--borda);
    border-radius: var(--raio);
    padding: 25px;
}

.atividade-adaptada h3 {
    margin-bottom: 10px;
}

.atividade-adaptada p {
    margin-bottom: 15px;
}

.atividade-adaptada .resposta {
    padding: 12px;
    border-radius: 10px;
    background: #f8f9fc;
    color: var(--texto-secundario);
}

/* ============================================================
   RODAPÉ
============================================================ */

.rodape {
    border-top: 1px solid var(--borda);
    background: white;
    color: var(--texto-secundario);
    text-align: center;
    padding: 25px;
    font-size: 13px;
}

/* ============================================================
   RESPONSIVO
============================================================ */

@media (max-width: 700px) {

    .topo {
        height: 75px;
    }

    .hero {
        min-height: calc(100vh - 130px);
    }

    .hero h1 {
        font-size: 43px;
        letter-spacing: -2px;
    }

    .grid-form {
        grid-template-columns: 1fr;
    }

    .campo-grande,
    .campo-total {
        grid-column: span 1;
    }

    .alternativas {
        grid-template-columns: 1fr;
    }

    .cartoes-estrategias {
        grid-template-columns: 1fr;
    }

    .avaliacao-topo {
        align-items: flex-start;
        flex-direction: column;
    }

    .badge-estrategia {
        margin-left: 0;
        margin-top: 7px;
    }

    .acoes-questao,
    .acoes-resultado {
        flex-direction: column;
    }

    .acoes-questao .btn,
    .acoes-resultado .btn {
        width: 100%;
    }
}
